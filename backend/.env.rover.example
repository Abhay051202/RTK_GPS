# Reach Stacker AI EdgeBox - create one per machine
DEVICE_ROLE=ROVER
RTK_DEVICE_ID=RS-01

# Use a stable Linux device path in production.
GNSS_PORT=/dev/serial/by-id/REPLACE_WITH_ZED_F9P_DEVICE
GNSS_BAUD=115200
GNSS_UBX_PORT=USB
GNSS_AUTO_CONFIGURE=true
GNSS_PERSIST_TO_BBR=true
ROVER_MEASUREMENT_RATE_MS=200
ROVER_API_ENABLED=true
ROVER_API_HOST=127.0.0.1
ROVER_API_PORT=8081

NTRIP_CASTER_HOST=rtk.prosperinfotech.com
NTRIP_CASTER_PORT=443
NTRIP_MOUNTPOINT=SARVESHWAR-CFS-BASE01
NTRIP_ROVER_USERNAME=RS-01
NTRIP_ROVER_PASSWORD=REPLACE_WITH_RS01_PASSWORD
NTRIP_TLS=true
NTRIP_RECONNECT_S=5

# Base/control-center IP or DNS reachable from the EdgeBox LAN.
TELEMETRY_URL=http://REPLACE_BASE_COMPUTER_IP:8000
TELEMETRY_API_TOKEN=REPLACE_WITH_BASE_RTK_TELEMETRY_TOKEN

# Precision gate used by ContainerVision/YMS logic
PRECISION_MAX_CORRECTION_AGE_S=5
PRECISION_MAX_HACC_M=0.05
