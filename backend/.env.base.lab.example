# Base commissioning / temporary test only
DEVICE_ROLE=BASE
GNSS_PORT=/dev/ttyACM0
GNSS_BAUD=115200
GNSS_UBX_PORT=USB
GNSS_AUTO_CONFIGURE=true
GNSS_PERSIST_TO_BBR=false

BASE_MODE=survey_in
BASE_SURVEY_MIN_DURATION_S=600
BASE_SURVEY_ACCURACY_LIMIT_M=0.50
BASE_RESET_SURVEY_ON_START=false
BASE_MEASUREMENT_RATE_MS=1000

BASE_PUBLISH_TO_NTRIP=true
NTRIP_CASTER_HOST=rtk.prosperinfotech.com
NTRIP_CASTER_PORT=443
NTRIP_MOUNTPOINT=SARVESHWAR-CFS-BASE01
NTRIP_SOURCE_PASSWORD=REPLACE_WITH_BASE_SOURCE_PASSWORD
NTRIP_TLS=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
RTK_TELEMETRY_TOKEN=REPLACE_WITH_LONG_RANDOM_EDGEBOX_TOKEN
RTK_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
