# Dedicated Sarveshwar Base computer - PRODUCTION
DEVICE_ROLE=BASE
GNSS_PORT=/dev/serial/by-id/REPLACE_WITH_ZED_F9P_DEVICE
GNSS_BAUD=115200
GNSS_UBX_PORT=USB
GNSS_AUTO_CONFIGURE=true
GNSS_PERSIST_TO_BBR=true
GNSS_RECONNECT_S=5

# IMPORTANT: production must use coordinates established by a competent survey.
BASE_MODE=fixed
BASE_FIXED_LATITUDE_DEG=18.000000000
BASE_FIXED_LONGITUDE_DEG=73.000000000
BASE_FIXED_HEIGHT_ELLIPSOID_M=0.0000
BASE_FIXED_POSITION_ACCURACY_M=0.02
BASE_MEASUREMENT_RATE_MS=1000

BASE_PUBLISH_TO_NTRIP=true
NTRIP_CASTER_HOST=rtk.prosperinfotech.com
NTRIP_CASTER_PORT=443
NTRIP_MOUNTPOINT=SARVESHWAR-CFS-BASE01
NTRIP_SOURCE_PASSWORD=REPLACE_WITH_ROTATED_BASE_SOURCE_PASSWORD
NTRIP_TLS=true
NTRIP_RECONNECT_S=5

# Dashboard/backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
RTK_TELEMETRY_TOKEN=REPLACE_WITH_LONG_RANDOM_EDGEBOX_TOKEN
RTK_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ROVER_OFFLINE_TIMEOUT_S=10
